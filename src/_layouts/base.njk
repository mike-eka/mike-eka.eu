<!doctype html>
<html lang="de">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}Mike Eka</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  <link rel="icon" href="/favicon.ico">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <h1><a href="/">Mike Eka</a></h1>

  <div id="menu">
    <div class="item"><a href="/blog/" class="{% if section == 'blog' %}current{% endif %}">Blog</a></div>
    <div class="item"><a href="/bio/" class="{% if section == 'bio' %}current{% endif %}">Bio</a></div>
    <div class="item"><a href="/sprache/" class="{% if section == 'sprache' %}current{% endif %}">Sprache</a></div>
    <div class="item"><a href="/polit/" class="{% if section == 'polit' %}current{% endif %}">Polit</a></div>
    <div class="item"><a href="/projects/" class="{% if section == 'projects' %}current{% endif %}">Projects</a></div>
  </div>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <a href="https://github.com/mike-eka/mike-eka.eu" target="_blank" rel="noopener">Source on GitHub</a>
  </footer>

  <script>
    const container = document.getElementById('menu');
    const items = [...container.children];
    const MOBILE_BREAKPOINT = 640; // keep in sync with the CSS media query
    const RIGHT_MARGIN = 60; // px kept clear on the right edge

    function layoutMenu() {
      if (window.innerWidth <= MOBILE_BREAKPOINT) {
        // Below the breakpoint the CSS media query stacks items flush left;
        // clear any inline offset so it doesn't fight with that.
        items.forEach((el) => { el.style.marginLeft = ''; });
        return;
      }

      // Reset offsets before measuring, so widths reflect an unshifted layout.
      items.forEach((el) => { el.style.marginLeft = '0px'; });

      const startX = container.getBoundingClientRect().left;
      const lastItemWidth = items[items.length - 1].getBoundingClientRect().width;
      const available = window.innerWidth - startX - lastItemWidth - RIGHT_MARGIN;
      const step = items.length > 1 ? available / (items.length - 1) : 0;

      items.forEach((el, i) => {
        el.style.marginLeft = Math.max(0, step * i) + 'px';
      });
    }

    layoutMenu();
    window.addEventListener('resize', layoutMenu);
  </script>

</body>

</html>
