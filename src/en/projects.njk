---
layout: base.njk
title: Projects
section: projects
---
{% set projects = collections.projects | byLocale(locale) %}
<h1 class="page-title">{{ i18n[locale].projects }}</h1>
<p class="page-intro">Small p5.js sketches, D3.js visualizations, and NLP scripts.</p>

{% if projects.length %}
<div class="project-grid">
  {% for project in projects %}
  <div class="project-card">
    <span class="project-kind">{{ project.data.kind }}</span>
    <h2><a href="{{ project.url }}">{{ project.data.title }}</a></h2>
    <p>{{ project.data.summary }}</p>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="empty-note">{{ i18n[locale].noProjects }}</p>
{% endif %}
