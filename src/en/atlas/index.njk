---
layout: base.njk
styles: ["/css/atlas.css"]
mainClass: atlas-wide
druckkopf: true
eleventyComputed:
  title: "{{ atlas.en.titel }}"
  description: "{{ atlas.en.kernsatz }}"
---
{#- English short version. Texts from src/_data/atlas/en.yaml; the patterns
    are named by their `fachbegriff` and link to the German cards. Only
    published cards are listed. Locale "en" comes from src/en/en.json. -#}
{%- set en = atlas.en -%}
{%- set eb = en.beschriftungen -%}
{%- set bm = atlas.begriffsmodell -%}
<article class="atlas atlas-uebersicht atlas-en">
  <header class="atlas-uebersicht__kopf">
    <h1 class="page-title">{{ en.titel }}</h1>
    {% if en.einleitung %}<p>{{ en.einleitung }}</p>{% endif %}
    <p class="atlas-kernsatz">{{ en.kernsatz }}</p>
    {#- the formal part, at the same place as on the German overview -#}
    {% if en.formal %}
    <p class="atlas-en-formal"><strong>{{ en.formal.titel }}.</strong> {{ en.formal.satz }} {{ en.formal.hinweis }}</p>
    <nav class="atlas-seitennav" aria-label="{{ en.formal.titel }}">
      <ul>
        {% for n in en.formal.links %}
        <li><a href="{{ n.url }}" hreflang="de">{{ n.label }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {% endif %}
  </header>

  <section class="atlas-struktur" aria-labelledby="en-fragen">
    <h2 id="en-fragen">{{ eb.fragen }}</h2>
    <ul class="atlas-baum">
      {% for q in bm.pruefragen %}{% if en.fragen[q.id] %}
      <li>{% if q.art == "rahmen" %}<span class="atlas-baum__art">{{ eb.rahmen }}:</span> {% endif %}{{ en.fragen[q.id] }}</li>
      {% endif %}{% endfor %}
    </ul>

    <h2 id="en-muster">{{ eb.hinsichten }}</h2>
    <ul class="atlas-hinsichten">
      {% for h in bm.hinsichten %}
      {%- set karten = collections.atlasMuster | musterInHinsicht(h.id) -%}
      <li class="{% if h.schwerpunkt == false %}ist-nebensache{% endif %}">
        {%- set eh = en.hinsichten[h.id] %}
        <span class="atlas-hinsicht__name">{{ eh.name or h.name }}</span>
        <span class="atlas-hinweis">{% if eh.erklaerung %}– {{ eh.erklaerung }}{% endif %}{% if h.schwerpunkt == false %} ({{ eb.nicht_schwerpunkt }}){% endif %}</span>
        {% if karten.length %}
        <ul>
          {% for k in karten %}
          <li><a href="{{ k.url }}" hreflang="de">{{ k.data.fachbegriff or k.data.titel }}</a> <span class="atlas-hinweis" lang="de">({{ k.data.titel }})</span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
    {% if en.muster_hinweis %}<p class="atlas-hinweis">{{ en.muster_hinweis }}</p>{% endif %}
    <p>
      <a class="atlas-weiter" href="/atlas/" hreflang="de">{{ eb.deutsch }}</a> ·
      <a class="atlas-weiter" href="/atlas/begriffsmodell/" hreflang="de">{{ eb.begriffsmodell }}</a>
    </p>
  </section>
</article>
