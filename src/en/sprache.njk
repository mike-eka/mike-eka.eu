---
layout: base.njk
title: Language
section: sprache
---
{#- English posts plus the German ones, which are listed (not translated)
    with their German title, linking to the German post. -#}
{% set posts = (collections.sprachePosts | byLocale("en")).concat(collections.sprachePosts | byLocale("de")) | sort(true, false, "date") %}
<h1 class="page-title">{{ i18n[locale].sprache }}</h1>

{% if posts.length %}
<ul class="entry-list">
  {% for post in posts %}
  {% set isGerman = (post.data.locale or "de") == "de" %}
  <li>
    <span class="entry-date">{{ post.data.date | dateDisplay(locale) }}</span>
    <a class="entry-title" href="{{ post.url }}"{% if isGerman %} hreflang="de" lang="de"{% endif %}>{{ post.data.title }}</a>{% if isGerman %} <span class="entry-lang">(in German)</span>{% endif %}
    {% if post.data.excerpt and not isGerman %}<p class="entry-excerpt">{{ post.data.excerpt }}</p>{% endif %}
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="empty-note">{{ i18n[locale].noPosts }}</p>
{% endif %}
