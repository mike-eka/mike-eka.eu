{#
  Schablone einer Einschätzung als CSS-Raster (kein SVG, damit lange Texte
  umbrechen). Die Felder sind bewusst im Code angelegt:
    Rahmen:  publikum (Für wen? – stellt sich bei jeder Einschätzung)
    Fragen:  inhalt (Was?), vergleichsfall (Im Vergleich wozu?), hinsicht
    Mitte:   urteil, wirkung

  felder: { inhalt|vergleichsfall|hinsicht|urteil|wirkung|publikum: { status, text } }
          status: offen | muster | belegt (fehlend = offen)
          text:   Liste von Zeilen (leere werden ausgelassen) oder Text
  b:      atlas.beschriftungen.schablone
  o:      Optionen
    kippFeld:         Feld der Stellschraube (aus kippt_an), z. B. "inhalt"
    einschaetzungen:  Liste { label, <kippFeld>, urteil, begruendung, wirkung? }
    grenzfallFrage:   Frage an der Stellschraube
    urteile:          begriffsmodell.urteile (Namen der Urteile)
    wirkungen:        begriffsmodell.wirkungen (Namen und Erklärungen)
    prefix:           eindeutiger Präfix für IDs
    publikumLink, publikumLinkText: Verweis auf den Abschnitt „Für wen?“

  Zwei Darstellungen der Einschätzungen:
    ohne JS ([data-ohne-js]): in der Stellschraube eine Liste, gruppiert nach
      Einschätzung – je Label als Zwischenüberschrift, Wert, Urteil,
      Begründung und Wirkung zusammen. Urteil- und Wirkungsfeld zeigen den
      Text des Musters.
    mit JS ([data-nur-js], anfangs hidden): Knöpfe in der Stellschraube; der
      Wert, das Urteil und ggf. die Wirkung der gewählten Einschätzung stehen
      in ihren Feldern. atlas.js schaltet zwischen beiden Darstellungen um.
#}

{% macro zeilen(f) -%}
  {%- set roh = (f.text if f and f.text else []) -%}
  {%- set liste = ([roh] if roh is string else (roh | select)) -%}
  {%- for zeile in liste %}{{ zeile }}{% if not loop.last %}<br>{% endif %}{% endfor -%}
{%- endmacro %}

{% macro kopf(id, b, zusatz, ebene) -%}
  {%- set h = "h" + (ebene or 3) -%}
  <{{ h }} class="atlas-feld__kopf">
    {%- if b.felder[id].frage %}<span class="atlas-feld__frage">{{ b.felder[id].frage }}</span><span class="atlas-feld__trenner" aria-hidden="true"> · </span>{% endif -%}
    <span class="atlas-feld__name">{{ b.felder[id].name }}</span>
    {%- if zusatz %} <span class="atlas-stellschraube-etikett">{{ zusatz }}</span>{% endif -%}
  </{{ h }}>
{%- endmacro %}

{% macro wert(id, e) -%}
  {%- if id == "inhalt" %}<q>{{ e[id] }}</q>{% else %}{{ e[id] }}{% endif -%}
{%- endmacro %}

{% macro urteilText(e, o) -%}
  {%- set u = o.urteile | nachId(e.urteil) -%}
  <strong class="atlas-variante__urteil">{{ u.name if u else e.urteil }}</strong>
  {%- if e.begruendung %} <span class="atlas-variante__begruendung">{{ e.begruendung }}</span>{% endif -%}
{%- endmacro %}

{# Wirkung einer Einschätzung; ohne `wirkung` der Text des Musters (f). #}
{#- wirkung may be one id or a list of ids (several effects) -#}
{% macro wirkungText(e, f, b, o) -%}
  {%- set ws = e.wirkung | alsListe -%}
  {%- if ws.length -%}
    {%- for id in ws -%}
      {%- set w = o.wirkungen | nachId(id) -%}
      {%- if not loop.first %}<br>{% endif -%}
      {%- if w -%}
        <strong class="atlas-variante__urteil">{{ w.name }}</strong> <span class="atlas-variante__begruendung">{{ w.erklaerung }}</span>
      {%- elif id == "keine" -%}
        <strong class="atlas-variante__urteil">{{ b.wirkung_keine }}</strong>
      {%- else -%}
        <strong class="atlas-variante__urteil">{{ id }}</strong>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    <span class="atlas-variante__begruendung">{{ zeilen(f) }}</span>
  {%- endif -%}
{%- endmacro %}

{% macro frageFeld(id, f, b, o, wirkungF) %}
  {%- set status = (f.status if f and f.status else "offen") -%}
  {%- set istKipp = (o.kippFeld == id) -%}
  {%- set mitSchalter = (istKipp and o.einschaetzungen and o.einschaetzungen.length) -%}
  <div class="atlas-feld atlas-feld--{{ id }} ist-{{ status }}{% if istKipp %} ist-stellschraube{% endif %}">
    {{ kopf(id, b, b.stellschraube if istKipp else "", o.ebene) }}
    <p class="atlas-feld__text">{{ zeilen(f) }}</p>
    <span class="visually-hidden">({{ b.status[status] }})</span>
    {% if mitSchalter %}
      {%- set mitWirkung = o.einschaetzungen | eindeutig("wirkung") | length -%}
      {% if o.grenzfallFrage %}<p class="atlas-grenzfrage">{{ o.grenzfallFrage }}</p>{% endif %}

      {# mit JS: Knöpfe und der Wert der gewählten Einschätzung #}
      <div class="atlas-schalter" role="group" aria-label="{{ b.schalter }}" data-nur-js hidden>
        {% for e in o.einschaetzungen %}
        <button type="button" data-ziel="{{ loop.index }}" aria-controls="{{ o.prefix }}-wert-{{ loop.index }} {{ o.prefix }}-urteil-{{ loop.index }}{% if mitWirkung %} {{ o.prefix }}-wirkung-{{ loop.index }}{% endif %}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ e.label }}</button>
        {% endfor %}
      </div>
      <ul class="atlas-varianten" data-nur-js hidden>
        {% for e in o.einschaetzungen %}
        <li class="atlas-variante" id="{{ o.prefix }}-wert-{{ loop.index }}" data-panel="{{ loop.index }}">
          <span class="visually-hidden">{{ e.label }}:</span>
          <span class="atlas-variante__wert">{{ wert(id, e) }}</span>
        </li>
        {% endfor %}
      </ul>

      {# ohne JS: nach Einschätzung gruppiert #}
      <div class="atlas-einschaetzungen" data-ohne-js>
        {% for e in o.einschaetzungen %}
        <section class="atlas-einschaetzung" aria-labelledby="{{ o.prefix }}-e{{ loop.index }}">
          {%- set hu = "h" + ((o.ebene or 3) + 1) -%}
          <{{ hu }} class="atlas-einschaetzung__titel" id="{{ o.prefix }}-e{{ loop.index }}">{{ e.label }}</{{ hu }}>
          <dl class="atlas-werte">
            <div><dt>{{ b.felder[id].name }}</dt><dd>{{ wert(id, e) }}</dd></div>
            <div><dt>{{ b.felder.urteil.name }}</dt><dd>{{ urteilText(e, o) }}</dd></div>
            {% if mitWirkung %}<div><dt>{{ b.felder.wirkung.name }}</dt><dd>{{ wirkungText(e, wirkungF, b, o) }}</dd></div>{% endif %}
          </dl>
        </section>
        {% endfor %}
      </div>
    {% endif %}
  </div>
{% endmacro %}

{% macro urteilFeld(f, b, o) %}
  {%- set mitVarianten = (o.kippFeld and o.einschaetzungen and o.einschaetzungen.length) -%}
  {%- set status = (f.status if f and f.status else "offen") -%}
  {# Mit Varianten neutral (folgt aus der Stellschraube), sonst nach Status #}
  <div class="atlas-feld atlas-feld--urteil {{ 'ist-neutral' if mitVarianten else 'ist-' + status }}">
    {{ kopf("urteil", b, "", o.ebene) }}
    {% if mitVarianten %}
      <p class="atlas-feld__hinweis">{{ b.urteil_hinweis }}</p>
      <ul class="atlas-varianten" aria-live="polite" data-nur-js hidden>
        {% for e in o.einschaetzungen %}
        <li class="atlas-variante" id="{{ o.prefix }}-urteil-{{ loop.index }}" data-panel="{{ loop.index }}">
          <span class="atlas-variante__label">{{ e.label }}</span>
          {{ urteilText(e, o) }}
        </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="atlas-feld__text">{{ zeilen(f) }}</p>
      <span class="visually-hidden">({{ b.status[status] }})</span>
    {% endif %}
  </div>
{% endmacro %}

{#
  Wirkung: Trägt mindestens eine Einschätzung ein Feld `wirkung`, schaltet
  das Feld mit dem Urteil um (neutral gestaltet, da es aus der Stellschraube
  folgt). Einschätzungen ohne `wirkung` zeigen dabei den Text des Musters.
  Trägt keine Einschätzung eine Wirkung, zeigt das Feld den Text des Musters.
#}
{% macro wirkungFeld(f, b, o) %}
  {%- set status = (f.status if f and f.status else "offen") -%}
  {%- set mitVarianten = (o.kippFeld and o.einschaetzungen and (o.einschaetzungen | eindeutig("wirkung") | length)) -%}
  {% if mitVarianten %}
  <div class="atlas-feld atlas-feld--wirkung ist-neutral">
    {{ kopf("wirkung", b, "", o.ebene) }}
    <p class="atlas-feld__text" data-ohne-js>{{ zeilen(f) }}</p>
    <ul class="atlas-varianten" aria-live="polite" data-nur-js hidden>
      {% for e in o.einschaetzungen %}
      <li class="atlas-variante" id="{{ o.prefix }}-wirkung-{{ loop.index }}" data-panel="{{ loop.index }}">
        <span class="atlas-variante__label">{{ e.label }}</span>
        {{ wirkungText(e, f, b, o) }}
      </li>
      {% endfor %}
    </ul>
  </div>
  {% else %}
  <div class="atlas-feld atlas-feld--wirkung ist-{{ status }}">
    {{ kopf("wirkung", b, "", o.ebene) }}
    <p class="atlas-feld__text">{{ zeilen(f) }}</p>
    <span class="visually-hidden">({{ b.status[status] }})</span>
  </div>
  {% endif %}
{% endmacro %}

{% macro schablone(felder, b, o) %}
{%- set genutzt = felder | schablonenStatus -%}
<figure class="atlas-schablone"{% if o.einschaetzungen and o.einschaetzungen.length %} data-atlas-schalter{% endif %}>
  <figcaption class="atlas-legende">
    <span>{{ b.legende }}</span>
    {% for key in ["belegt"] %}{% if key in genutzt %}
    <span class="atlas-legende__eintrag"><span class="atlas-legende__probe ist-{{ key }}" aria-hidden="true"></span>{{ b.status[key] }}</span>
    {% endif %}{% endfor %}
  </figcaption>
  <div class="atlas-rahmen">
    <p class="atlas-rahmen__band">
      <span class="atlas-feld__frage">{{ b.felder.publikum.frage }}</span><span aria-hidden="true"> · </span><span class="atlas-feld__name">{{ b.felder.publikum.name }}</span>:
      {%- set publikumText %}{{ zeilen(felder.publikum) }}{% endset %}
      {% if publikumText | trim %}{{ publikumText | trim | safe }} – {% endif %}{{ b.publikum_verweis }}
      {% if o.publikumLink %}<a href="{{ o.publikumLink }}">{{ o.publikumLinkText }}</a>{% endif %}
    </p>
    <div class="atlas-schablone__raster">
      {{ frageFeld("inhalt", felder.inhalt, b, o, felder.wirkung) }}
      {{ frageFeld("vergleichsfall", felder.vergleichsfall, b, o, felder.wirkung) }}
      {{ frageFeld("hinsicht", felder.hinsicht, b, o, felder.wirkung) }}
      <div class="atlas-schablone__mitte">
        <p class="atlas-schablone__mitte-titel">{{ b.mitte }}</p>
        {{ urteilFeld(felder.urteil, b, o) }}
        {{ wirkungFeld(felder.wirkung, b, o) }}
      </div>
    </div>
  </div>
</figure>
{% endmacro %}
