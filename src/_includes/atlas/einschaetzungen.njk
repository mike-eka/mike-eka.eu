{#
  Grenzfall-Schalter: beliebig viele Einschätzungen desselben Inhalts.
  Ohne JS stehen alle Einschätzungen untereinander; atlas.js blendet die
  Knöpfe ein und zeigt jeweils eine.

  liste:  einschaetzungen einer Karte ({ label, publikum, urteil, begruendung, wirkung })
  bm:     atlas.begriffsmodell (für die Namen von Urteil und Wirkung)
  b:      atlas.beschriftungen.einschaetzung
  prefix: eindeutiger Präfix für die IDs auf der Seite
#}
{% macro einschaetzungen(liste, bm, b, prefix) %}
<div class="atlas-einschaetzungen" data-atlas-schalter>
  <div class="atlas-schalter" role="group" aria-label="{{ b.schalter }}" hidden>
    {% for e in liste %}
    <button type="button" data-ziel="{{ prefix }}-{{ loop.index }}" aria-controls="{{ prefix }}-{{ loop.index }}" aria-pressed="{{ 'true' if loop.first else 'false' }}">{{ e.label }}</button>
    {% endfor %}
  </div>
  <div class="atlas-einschaetzungen__liste" aria-live="polite">
    {% for e in liste %}
    {%- set urteil = bm.urteile | nachId(e.urteil) -%}
    {%- set wirkung = bm.wirkungen | nachId(e.wirkung) -%}
    <section class="atlas-einschaetzung ist-{{ e.urteil }}" id="{{ prefix }}-{{ loop.index }}" data-panel aria-labelledby="{{ prefix }}-{{ loop.index }}-titel">
      <h3 class="atlas-einschaetzung__titel" id="{{ prefix }}-{{ loop.index }}-titel">{{ e.label }}</h3>
      <dl class="atlas-werte">
        {% if e.publikum %}<div><dt>{{ b.publikum }}</dt><dd>{{ e.publikum }}</dd></div>{% endif %}
        <div class="atlas-einschaetzung__urteil"><dt>{{ b.urteil }}</dt><dd>{{ urteil.name if urteil else e.urteil }}</dd></div>
        {% if e.begruendung %}<div><dt>{{ b.begruendung }}</dt><dd>{{ e.begruendung }}</dd></div>{% endif %}
        <div><dt>{{ b.wirkung }}</dt><dd>{{ wirkung.name if wirkung else (b.keine_wirkung if (not e.wirkung or e.wirkung == "keine") else e.wirkung) }}</dd></div>
      </dl>
    </section>
    {% endfor %}
  </div>
</div>
{% endmacro %}
