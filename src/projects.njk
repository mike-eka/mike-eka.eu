---
layout: base.njk
title: Projects
section: projects
---
<h1 class="page-title">Projects</h1>
<p class="page-intro">Small p5.js sketches, D3.js visualizations, and NLP scripts.</p>

{% if collections.projects.length %}
<div class="project-grid">
  {% for project in collections.projects %}
  <div class="project-card">
    <span class="project-kind">{{ project.data.kind }}</span>
    <h2><a href="{{ project.url }}">{{ project.data.title }}</a></h2>
    <p>{{ project.data.summary }}</p>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="empty-note">Nothing published yet.</p>
{% endif %}
